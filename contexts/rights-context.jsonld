{
  "@context": {
    "hro": "https://ns.webcivics.net/license-rights/",
    "jural": "https://ns.webcivics.net/jural/",
    "values": "https://ns.webcivics.net/values/",
    "agency": "https://ns.webcivics.net/agency/",
    "spc": "https://ns.webcivics.net/social-permissive-commons/",
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "prov": "http://www.w3.org/ns/prov#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "id": "@id",
    "type": "@type",
    "position": {"@id": "hro:position", "@type": "@id"},
    "holder": {"@id": "hro:holder", "@type": "@id"},
    "counterparty": {"@id": "hro:counterparty", "@type": "@id"},
    "action": {"@id": "hro:action", "@type": "@id"},
    "resource": {"@id": "hro:resource", "@type": "@id"},
    "purpose": "hro:purpose",
    "context": "hro:context",
    "authoritySource": {"@id": "hro:authoritySource", "@type": "@id"},
    "legalInstrument": {"@id": "hro:legalInstrument", "@type": "@id"},
    "technicalInstrument": {"@id": "hro:technicalInstrument", "@type": "@id"},
    "condition": "hro:condition",
    "validFrom": {"@id": "hro:validFrom", "@type": "xsd:dateTime"},
    "validUntil": {"@id": "hro:validUntil", "@type": "xsd:dateTime"},
    "delegationDepth": {"@id": "hro:delegationDepth", "@type": "xsd:nonNegativeInteger"},
    "revocationMechanism": "hro:revocationMechanism",
    "evidence": {"@id": "hro:evidence", "@type": "@id"},
    "verificationStatus": {"@id": "hro:verificationStatus", "@type": "@id"},
    "remedy": {"@id": "hro:remedy", "@type": "@id"},
    "issuer": {"@id": "hro:issuer", "@type": "@id"},
    "subject": {"@id": "hro:subject", "@type": "@id"},
    "principal": {"@id": "hro:principal", "@type": "@id"},
    "audience": {"@id": "hro:audience", "@type": "@id"},
    "legalEffect": {"@id": "hro:legalEffect", "@type": "@id"},
    "creator": {"@id": "hro:creator", "@type": "@id"},
    "contributor": {"@id": "hro:contributor", "@type": "@id"},
    "investment": {"@id": "hro:investment", "@type": "@id"},
    "investmentCategory": "hro:investmentCategory",
    "valuationMethod": "hro:valuationMethod",
    "recoveryTreatment": "hro:recoveryTreatment",
    "publicInspectionNotPermission": {"@id": "hro:publicInspectionNotPermission", "@type": "xsd:boolean"},
    "technicalAccessNotPermission": {"@id": "hro:technicalAccessNotPermission", "@type": "xsd:boolean"},
    "commercialExploitationRequiresPermission": {"@id": "hro:commercialExploitationRequiresPermission", "@type": "xsd:boolean"},
    "aiUseRequiresExpressPermission": {"@id": "hro:aiUseRequiresExpressPermission", "@type": "xsd:boolean"},
    "mayRefuseOrConditionLicence": {"@id": "hro:mayRefuseOrConditionLicence", "@type": "xsd:boolean"},
    "excludedAgentsReceiveNoLicence": {"@id": "hro:excludedAgentsReceiveNoLicence", "@type": "xsd:boolean"},
    "creatorEconomicSurvivalIsHumanitarianInterest": {"@id": "hro:creatorEconomicSurvivalIsHumanitarianInterest", "@type": "xsd:boolean"}
  }
}
